FROM node:22-bookworm-slim
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates openssl && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL --retry 3 https://github.com/Y2Z/monolith/releases/download/v2.11.7/monolith-cli-linux-x86_64 -o /usr/local/bin/monolith && chmod +x /usr/local/bin/monolith
RUN corepack enable
COPY . .
RUN corepack yarn workspaces focus @linkwarden/worker @linkwarden/web && corepack yarn prisma:generate
RUN node node_modules/playwright/cli.js install --with-deps chromium-headless-shell
ENV NODE_ENV=production
WORKDIR /app/apps/worker
CMD ["node", "../../node_modules/tsx/dist/cli.mjs", "worker.ts"]
