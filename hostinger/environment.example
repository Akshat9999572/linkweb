# Copy to .env.hostinger at the repository root. Never commit the populated file.
LINKWEB_DOMAIN=bookmarks.example.com
LINKWEB_ACCESS_USER=akshat
# Quote the bcrypt hash so Compose preserves every dollar sign.
LINKWEB_ACCESS_HASH='$2a$REPLACE_WITH_A_REAL_CADDY_PASSWORD_HASH'
PERSONAL_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NEXTAUTH_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
PERSONAL_MODE=true
PERSONAL_PROFILE_ID=1
NEXT_PUBLIC_CREDENTIALS_ENABLED=true
NEXT_PUBLIC_DISABLE_REGISTRATION=true
NEXT_PUBLIC_STRIPE=false
NEXT_PUBLIC_EMAIL_PROVIDER=false
NEXT_PUBLIC_DEMO=false
NEXT_PUBLIC_RSS_POLLING_INTERVAL_MINUTES=60
# Retain the current database and private archives during the hosting move.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
STORAGE_BACKEND=vercel-blob
BLOB_READ_WRITE_TOKEN=
