{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && corepack yarn workspaces focus @linkwarden/web @linkwarden/worker",
      "buildCommand": "cd ../.. && node scripts/build-vercel.mjs"
    }
  },
  "daemons": {
    "preservation": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": { "bom1": 1 },
      "resources": { "requests": { "memory": "1Gi" } }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
